<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme using Material 3 DayNight -->
    <style name="Theme.SoThich" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Palette Colors (3 lớp TÁCH BIỆT: Nền #FAF7F2, Thẻ/ô nhập #FFFFFF, Viền #E6DED3) -->
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/color_surface_variant</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/color_on_accent</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/color_on_accent</item>
        <item name="colorSecondaryContainer">@color/nav_active_indicator</item>
        <item name="colorOnSecondaryContainer">@color/accent</item>
        <item name="colorOutline">@color/border</item>
        <item name="colorOutlineVariant">@color/border</item>
        <item name="android:textColorPrimary">@color/color_text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- System Bars: Nền canvas #FAF7F2, Thanh điều hướng dưới đáy tiệp nền @color/surface -->
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Flat UI: No drop shadows or skeuomorphic elevations -->
        <item name="elevationOverlayEnabled">false</item>
        <item name="materialCardViewStyle">@style/Widget.App.CardView</item>
        <item name="textInputStyle">@style/Widget.App.TextInputLayout</item>

        <!-- Default Font: SVN-Gilroy -->
        <item name="fontFamily">@font/svn_gilroy</item>
        <item name="android:fontFamily">@font/svn_gilroy</item>

        <!-- Đồng bộ hiệu ứng chuyển màn hình: Hard Cut toàn bộ -->
        <item name="android:windowAnimationStyle">@style/Animation.App.HardCut</item>
    </style>

    <!-- Card: 12dp corner radius, 1dp border hairline, 0dp elevation -->
    <style name="Widget.App.CardView" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">12dp</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.Corner12</item>
    </style>

    <!-- Input: 12dp corner radius, 1dp border hairline -->
    <style name="Widget.App.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/border</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxBackgroundColor">@color/surface</item>
    </style>

    <!-- Shape Appearance: 12dp corner -->
    <style name="ShapeAppearance.App.Corner12" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">12dp</item>
    </style>

    <!-- Title typography: SVN-Gilroy -->
    <style name="TextAppearance.App.Title" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/svn_gilroy</item>
        <item name="android:fontFamily">@font/svn_gilroy</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="TextAppearance.App.TitleCard" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/svn_gilroy</item>
        <item name="android:fontFamily">@font/svn_gilroy</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Body typography: SVN-Gilroy -->
    <style name="TextAppearance.App.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/svn_gilroy</item>
        <item name="android:fontFamily">@font/svn_gilroy</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.App.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">@font/svn_gilroy</item>
        <item name="android:fontFamily">@font/svn_gilroy</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Bottom Navigation Typography: SVN-Gilroy Semibold/Bold to rõ, lấp đầy không gian hài hòa -->
    <style name="TextAppearance.App.BottomNav" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/svn_gilroy_semibold</item>
        <item name="android:fontFamily">@font/svn_gilroy_semibold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.App.BottomNav.Active" parent="TextAppearance.App.BottomNav">
        <item name="fontFamily">@font/svn_gilroy_bold</item>
        <item name="android:fontFamily">@font/svn_gilroy_bold</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14.5sp</item>
    </style>

    <!-- Custom Active Indicator: to rộng cân đối (74dp x 38dp), không đè lên nhãn chữ -->
    <style name="Widget.App.BottomNav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:width">74dp</item>
        <item name="android:height">38dp</item>
        <item name="android:color">@color/nav_active_indicator</item>
    </style>

    <!-- Splash Screen Theme (androidx.core:core-splashscreen) -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/color_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_notebook_open</item>
        <item name="postSplashScreenTheme">@style/Theme.SoThich</item>
    </style>
    <!-- Activity Transition Animations: Đồng bộ Hard Cut tức thì cho toàn bộ ứng dụng -->
    <style name="Animation.App.HardCut" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/no_anim</item>
        <item name="android:activityOpenExitAnimation">@anim/no_anim</item>
        <item name="android:activityCloseEnterAnimation">@anim/no_anim</item>
        <item name="android:activityCloseExitAnimation">@anim/no_anim</item>
        <item name="android:taskOpenEnterAnimation">@anim/no_anim</item>
        <item name="android:taskOpenExitAnimation">@anim/no_anim</item>
        <item name="android:taskCloseEnterAnimation">@anim/no_anim</item>
        <item name="android:taskCloseExitAnimation">@anim/no_anim</item>
        <item name="android:taskToFrontEnterAnimation">@anim/no_anim</item>
        <item name="android:taskToFrontExitAnimation">@anim/no_anim</item>
        <item name="android:taskToBackEnterAnimation">@anim/no_anim</item>
        <item name="android:taskToBackExitAnimation">@anim/no_anim</item>
    </style>
</resources>
