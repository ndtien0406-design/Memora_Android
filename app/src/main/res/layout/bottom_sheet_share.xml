<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/color_surface"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Thanh kéo BottomSheet -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_bottom_sheet_drag_handle" />

    <!-- Tiêu đề Chia sẻ sở thích -->
    <TextView
        android:id="@+id/tv_share_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingBottom="12dp"
        android:text="@string/dialog_title_share"
        android:textAppearance="@style/TextAppearance.App.Title"
        android:textColor="@color/color_text_primary"
        android:textSize="18sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="14dp">

        <!-- Dòng tóm tắt (ảnh nhỏ, tên, danh mục, sao) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="14dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="52dp"
                android:layout_height="52dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border"
                app:cardBackgroundColor="@color/color_surface_variant">

                <ImageView
                    android:id="@+id/iv_share_thumb"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_hobby_placeholder" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_share_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.App.Body"
                    android:textColor="@color/color_text_primary"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Rừng Na Uy" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/tv_share_category"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.App.Caption"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="12sp"
                        tools:text="Sách" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" • "
                        android:textColor="@color/color_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_share_rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.App.Caption"
                        android:textColor="@color/color_accent"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        tools:text="5/5 sao" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border" />

        <!-- 2 Công tắc Switch: Kèm ảnh và Kèm ghi chú -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_include_image"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/switch_include_image"
            android:textAppearance="@style/TextAppearance.App.Body"
            android:textColor="@color/color_text_primary"
            android:textSize="14sp"
            android:checked="true" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_include_note"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/switch_include_note"
            android:textAppearance="@style/TextAppearance.App.Body"
            android:textColor="@color/color_text_primary"
            android:textSize="14sp"
            android:checked="true" />

        <!-- Khối "NỘI DUNG SẼ GỬI" -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/header_content_to_send"
            android:textAppearance="@style/TextAppearance.App.Caption"
            android:textColor="@color/color_text_secondary"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/layout_preview_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_suggestion_card"
            android:padding="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_preview_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.App.Body"
                android:textColor="@color/color_text_primary"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                tools:text="Rừng Na Uy\nDanh mục: Sách\nĐánh giá: 5/5 sao\nGhi chú: Tiểu thuyết kinh điển" />
        </LinearLayout>

        <!-- Hàng nút Chia sẻ và Hủy -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="20dp">

            <!-- Nút Hủy -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_share_cancel"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/btn_cancel"
                android:textColor="@color/color_text_secondary"
                android:textSize="15sp" />

            <!-- Nút Chia sẻ -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_share_confirm"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.3"
                android:layout_marginStart="8dp"
                android:text="@string/action_share"
                android:textColor="@color/color_on_accent"
                android:backgroundTint="@color/color_accent"
                app:cornerRadius="12dp"
                app:elevation="0dp"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
