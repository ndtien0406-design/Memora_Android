<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/color_surface"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Thanh kéo BottomSheet -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_bottom_sheet_drag_handle" />

    <!-- Tiêu đề Thêm ảnh -->
    <TextView
        android:id="@+id/tv_sheet_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingBottom="12dp"
        android:text="@string/dialog_title_add_photo"
        android:textAppearance="@style/TextAppearance.App.Title"
        android:textColor="@color/color_text_primary"
        android:textSize="18sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <!-- Dòng 1: Chụp ảnh -->
    <LinearLayout
        android:id="@+id/btn_action_camera"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_camera"
            android:contentDescription="@null"
            app:tint="@color/color_text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/action_take_photo"
            android:textAppearance="@style/TextAppearance.App.Body"
            android:textColor="@color/color_text_primary"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Dòng 2: Chọn từ thư viện -->
    <LinearLayout
        android:id="@+id/btn_action_gallery"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_photo_library"
            android:contentDescription="@null"
            app:tint="@color/color_text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/action_choose_gallery"
            android:textAppearance="@style/TextAppearance.App.Body"
            android:textColor="@color/color_text_primary"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Dòng 3: Xóa ảnh (chữ đỏ nhạt, chỉ hiện khi đã có ảnh) -->
    <LinearLayout
        android:id="@+id/btn_action_remove_photo"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_delete"
            android:contentDescription="@null"
            app:tint="@color/color_error" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/action_remove_photo"
            android:textAppearance="@style/TextAppearance.App.Body"
            android:textColor="@color/color_error"
            android:textSize="15sp" />
    </LinearLayout>

</LinearLayout>
