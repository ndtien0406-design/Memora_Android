<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/add_edit_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_background"
    android:fitsSystemWindows="true">

    <!-- Top Bar: Nút Back, Tiêu đề serif Fraunces và Avatar tròn màu nhấn bên phải -->
    <LinearLayout
        android:id="@+id/top_bar_add_edit"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@color/color_background">

        <!-- Toolbar chuẩn giữ ID cũ cho NavigationListener -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/transparent"
            app:contentInsetStartWithNavigation="0dp"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationContentDescription="@string/action_back"
            app:title="@string/title_add_hobby"
            app:titleTextAppearance="@style/TextAppearance.App.Title"
            app:titleTextColor="@color/color_text_primary" />

        <!-- Biểu tượng avatar người dùng tròn màu nhấn theo Image 3 -->
        <FrameLayout
            android:id="@+id/btn_header_profile"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_circle_play"
            android:contentDescription="@null">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_person"
                app:tint="@color/color_on_accent"
                android:contentDescription="@null" />
        </FrameLayout>
    </LinearLayout>

    <!-- Form cuộn trong ScrollView -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="12dp"
            android:paddingBottom="36dp">

            <!-- 0. Khung hình ảnh kỷ niệm lớn theo Image 3 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_image_picker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border"
                app:cardBackgroundColor="@color/color_surface_variant">

                <!-- Trạng thái trống: icon camera, tiêu đề, mô tả và 2 nút Chụp ảnh / Thư viện -->
                <LinearLayout
                    android:id="@+id/layout_empty_image"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="20dp">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_soft_circle">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_camera"
                            app:tint="@color/color_accent"
                            android:contentDescription="@null" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/title_add_photo_memory"
                        android:textAppearance="@style/TextAppearance.App.Body"
                        android:textColor="@color/color_text_primary"
                        android:textStyle="bold"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:paddingHorizontal="16dp"
                        android:text="@string/desc_add_photo_memory"
                        android:textAppearance="@style/TextAppearance.App.Caption"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="12sp"
                        android:lineSpacingExtra="2dp" />

                    <!-- 2 nút thao tác Chụp ảnh và Thư viện -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="14dp">

                        <LinearLayout
                            android:id="@+id/btn_take_photo"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_chip_unselected"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_camera"
                                app:tint="@color/color_accent"
                                android:contentDescription="@null" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="@string/action_take_photo"
                                android:textAppearance="@style/TextAppearance.App.Body"
                                android:textColor="@color/color_text_primary"
                                android:textSize="12.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/btn_choose_gallery"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_chip_unselected"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_photo_library"
                                app:tint="@color/color_accent"
                                android:contentDescription="@null" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="@string/action_choose_gallery"
                                android:textAppearance="@style/TextAppearance.App.Body"
                                android:textColor="@color/color_text_primary"
                                android:textSize="12.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Trạng thái đã chọn ảnh -->
                <FrameLayout
                    android:id="@+id/layout_selected_image"
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:visibility="gone"
                    tools:visibility="gone">

                    <ImageView
                        android:id="@+id/iv_selected_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/label_cover_photo" />

                    <!-- Nút đổi ảnh nổi bo tròn -->
                    <LinearLayout
                        android:id="@+id/btn_change_photo"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="10dp"
                        android:background="@drawable/bg_chip_selected"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="12dp"
                        android:orientation="horizontal"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_camera"
                            app:tint="@color/color_on_accent"
                            android:contentDescription="@null" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="@string/action_change_photo"
                            android:textColor="@color/color_on_accent"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 1. Tên sở thích * & MỤC LỤC #... -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_hobby_name"
                    android:textAppearance="@style/TextAppearance.App.Caption"
                    android:textColor="@color/color_text_primary"
                    android:textStyle="bold"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_catalog_index"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MỤC LỤC #042"
                    android:textAppearance="@style/TextAppearance.App.Caption"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="11sp"
                    android:letterSpacing="0.04" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_hobby_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:hintEnabled="false"
                app:errorEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_hobby_name"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_search_bar"
                    android:hint="@string/hint_hobby_name"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences"
                    android:paddingHorizontal="14dp"
                    android:singleLine="true"
                    android:textAppearance="@style/TextAppearance.App.TitleCard"
                    android:textColor="@color/color_text_primary"
                    android:textSize="17sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 2. Danh mục lưu trữ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/label_category_storage"
                android:textAppearance="@style/TextAppearance.App.Caption"
                android:textColor="@color/color_text_primary"
                android:textStyle="bold"
                android:textSize="13sp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_category"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="6dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border"
                app:cardBackgroundColor="@color/color_surface">

                <LinearLayout
                    android:id="@+id/layout_category_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_category_icon_box">

                        <ImageView
                            android:id="@+id/iv_category_icon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_book"
                            app:tint="@color/color_accent"
                            android:contentDescription="@null" />
                    </FrameLayout>

                    <AutoCompleteTextView
                        android:id="@+id/actv_category"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:background="@null"
                        android:inputType="none"
                        android:clickable="true"
                        android:focusable="false"
                        android:cursorVisible="false"
                        android:textAppearance="@style/TextAppearance.App.Body"
                        android:textColor="@color/color_text_primary"
                        android:textStyle="bold"
                        android:textSize="14.5sp"
                        tools:text="Sách" />

                    <ImageView
                        android:id="@+id/iv_category_dropdown_arrow"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_keyboard_arrow_down"
                        app:tint="@color/color_text_secondary"
                        android:contentDescription="@null" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. Cảm nhận đánh giá & Rating sao -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border"
                app:cardBackgroundColor="@color/color_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_rating_feeling"
                            android:textAppearance="@style/TextAppearance.App.Body"
                            android:textColor="@color/color_text_primary"
                            android:textStyle="bold"
                            android:textSize="13.5sp" />

                        <TextView
                            android:id="@+id/tv_rating_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/TextAppearance.App.Caption"
                            android:textColor="@color/color_text_secondary"
                            android:textSize="12sp"
                            tools:text="5/5 sao – Tuyệt tác cá nhân" />
                    </LinearLayout>

                    <RatingBar
                        android:id="@+id/rating_bar_input"
                        style="?android:attr/ratingBarStyleIndicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:isIndicator="false"
                        android:numStars="5"
                        android:rating="5"
                        android:stepSize="1.0"
                        android:progressTint="@color/color_star"
                        android:secondaryProgressTint="@color/color_star" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 4. Trang ghi chép -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/label_notes_page"
                android:textAppearance="@style/TextAppearance.App.Caption"
                android:textColor="@color/color_text_primary"
                android:textStyle="bold"
                android:textSize="13sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_hobby_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_hobby_notes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minLines="4"
                    android:gravity="top|start"
                    android:background="@drawable/bg_search_bar"
                    android:hint="@string/hint_note"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine|textCapSentences"
                    android:padding="14dp"
                    android:textAppearance="@style/TextAppearance.App.Body"
                    android:textColor="@color/color_text_primary"
                    android:textColorHint="@color/color_text_secondary"
                    android:textSize="13.5sp"
                    android:lineSpacingExtra="3dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Khối Ghi chú bằng giọng nói (Bước 10) -->
            <LinearLayout
                android:id="@+id/layout_voice_note_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="10dp">

                <FrameLayout
                    android:id="@+id/container_voice_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- Trạng thái 1: Chưa ghi âm -->
                    <LinearLayout
                        android:id="@+id/layout_audio_idle"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_audio_container"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/iv_mic_icon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_mic"
                            app:tint="@color/color_accent"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/tv_tap_to_record"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/btn_tap_to_record"
                            android:textAppearance="@style/TextAppearance.App.Body"
                            android:textColor="@color/color_accent"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Trạng thái 2: Đang ghi âm -->
                    <LinearLayout
                        android:id="@+id/layout_audio_recording"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_audio_container"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="14dp"
                        android:visibility="gone">

                        <View
                            android:id="@+id/view_recording_dot"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@drawable/bg_record_dot" />

                        <TextView
                            android:id="@+id/tv_recording_status"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            tools:text="Đang ghi 00:00"
                            android:textAppearance="@style/TextAppearance.App.Body"
                            android:textColor="@color/color_error"
                            android:textStyle="bold"
                            android:textSize="14sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_stop_recording"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="@string/btn_stop_recording"
                            android:textColor="@color/color_error"
                            app:icon="@drawable/ic_stop"
                            app:iconTint="@color/color_error"
                            app:cornerRadius="12dp"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Trạng thái 3: Đã ghi âm xong -->
                    <LinearLayout
                        android:id="@+id/layout_audio_recorded"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_audio_container"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="12dp"
                        android:visibility="gone">

                        <ImageButton
                            android:id="@+id/btn_play_audio"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_circle_play"
                            android:src="@drawable/ic_play_arrow"
                            android:contentDescription="Phát ghi âm"
                            app:tint="@color/color_on_accent" />

                        <SeekBar
                            android:id="@+id/seekbar_audio"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="6dp"
                            android:progressTint="@color/color_accent"
                            android:thumbTint="@color/color_accent" />

                        <TextView
                            android:id="@+id/tv_audio_duration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/initial_audio_duration"
                            android:textAppearance="@style/TextAppearance.App.Caption"
                            android:textColor="@color/color_text_secondary"
                            android:textSize="11.5sp" />

                        <ImageButton
                            android:id="@+id/btn_delete_audio"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginStart="6dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_delete"
                            android:contentDescription="@string/action_delete_audio"
                            app:tint="@color/color_error" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <!-- 5. Khối Nhắc nhở theo Image 3 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_reminder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border"
                app:cardBackgroundColor="@color/color_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:animateLayoutChanges="true"
                    android:orientation="vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="14dp">

                    <!-- Hàng tiêu đề & Switch bật tắt -->
                    <LinearLayout
                        android:id="@+id/layout_reminder_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true">

                        <FrameLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_category_icon_box">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_notifications"
                                app:tint="@color/color_accent"
                                android:contentDescription="@null" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_reminder"
                                android:textAppearance="@style/TextAppearance.App.Body"
                                android:textColor="@color/color_text_primary"
                                android:textStyle="bold"
                                android:textSize="14.5sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="@string/desc_reminder"
                                android:textAppearance="@style/TextAppearance.App.Caption"
                                android:textColor="@color/color_text_secondary"
                                android:textSize="11.5sp" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_reminder"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:thumbTint="@color/color_surface"
                            app:trackTint="@color/color_accent" />
                    </LinearLayout>

                    <!-- Khung chọn Ngày và Giờ khi Switch bật -->
                    <LinearLayout
                        android:id="@+id/layout_reminder_datetime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="12dp"
                            android:background="@color/border" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <!-- Ô Chọn ngày -->
                            <LinearLayout
                                android:id="@+id/btn_pick_date"
                                android:layout_width="0dp"
                                android:layout_height="54dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_reminder_box"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="12dp"
                                android:clickable="true"
                                android:focusable="true">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/label_reminder_date"
                                        android:textAppearance="@style/TextAppearance.App.Caption"
                                        android:textColor="@color/color_text_secondary"
                                        android:textSize="11sp" />

                                    <TextView
                                        android:id="@+id/tv_reminder_date"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        tools:text="02/10/2026"
                                        android:textAppearance="@style/TextAppearance.App.Body"
                                        android:textColor="@color/color_text_primary"
                                        android:textStyle="bold"
                                        android:textSize="13sp" />
                                </LinearLayout>

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:src="@drawable/ic_calendar"
                                    android:contentDescription="@null"
                                    app:tint="@color/color_text_secondary" />
                            </LinearLayout>

                            <!-- Ô Chọn giờ -->
                            <LinearLayout
                                android:id="@+id/btn_pick_time"
                                android:layout_width="0dp"
                                android:layout_height="54dp"
                                android:layout_weight="1"
                                android:layout_marginStart="6dp"
                                android:background="@drawable/bg_reminder_box"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="12dp"
                                android:clickable="true"
                                android:focusable="true">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/label_reminder_time"
                                        android:textAppearance="@style/TextAppearance.App.Caption"
                                        android:textColor="@color/color_text_secondary"
                                        android:textSize="11sp" />

                                    <TextView
                                        android:id="@+id/tv_reminder_time"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        tools:text="20:00"
                                        android:textAppearance="@style/TextAppearance.App.Body"
                                        android:textColor="@color/color_text_primary"
                                        android:textStyle="bold"
                                        android:textSize="13sp" />
                                </LinearLayout>

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:src="@drawable/ic_clock"
                                    android:contentDescription="@null"
                                    app:tint="@color/color_text_secondary" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Dòng thông tin lặp lại nhắc nhở theo Image 3 -->
                        <LinearLayout
                            android:id="@+id/btn_change_weekly_reminder"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_reminder_box"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="8dp"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_notifications"
                                app:tint="@color/color_accent"
                                android:contentDescription="@null" />

                            <TextView
                                android:id="@+id/tv_weekly_reminder_text"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                android:text="@string/reminder_repeat_weekly"
                                android:textAppearance="@style/TextAppearance.App.Caption"
                                android:textColor="@color/color_text_primary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tv_change_weekly_action"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/action_change"
                                android:textAppearance="@style/TextAppearance.App.Caption"
                                android:textColor="@color/color_accent"
                                android:textStyle="bold"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Nút Lưu vào thư viện (Filled terracotta 12dp) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="28dp"
                android:text="@string/btn_save_to_library"
                android:textColor="@color/color_on_accent"
                android:backgroundTint="@color/color_accent"
                app:icon="@drawable/ic_bookmark"
                app:iconTint="@color/color_on_accent"
                app:iconGravity="textStart"
                app:cornerRadius="12dp"
                app:elevation="0dp"
                android:textAppearance="@style/TextAppearance.App.Body"
                android:textStyle="bold"
                android:textSize="15sp" />

            <!-- Nút Hủy lưu (Text button giữa màn) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cancel"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp"
                android:text="@string/btn_cancel_save"
                android:textColor="@color/color_text_secondary"
                android:textSize="13.5sp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
