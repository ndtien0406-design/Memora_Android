<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:fitsSystemWindows="true">

    <!-- Top Bar: Tiêu đề "Cài đặt" font serif và nút 3 chấm -->
    <LinearLayout
        android:id="@+id/header_settings_bar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_settings_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_settings"
            android:textAppearance="@style/TextAppearance.App.Title"
            android:textColor="@color/color_text_primary"
            android:textSize="26sp" />
    </LinearLayout>

    <!-- Nội dung cuộn Cài đặt -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_settings_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/header_settings_bar"
        app:layout_constraintBottom_toTopOf="@id/included_bottom_nav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <!-- Nhãn TÙY BIẾN ỨNG DỤNG -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/header_app_customization"
                android:textAppearance="@style/TextAppearance.App.Caption"
                android:textColor="@color/color_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <!-- Tiêu đề "Tùy chọn hiển thị" -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/title_display_options"
                android:textAppearance="@style/TextAppearance.App.Title"
                android:textColor="@color/color_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Mô tả ngắn -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/desc_display_options"
                android:textAppearance="@style/TextAppearance.App.Caption"
                android:textColor="@color/color_text_secondary"
                android:textSize="13sp" />

            <!-- 1. Mục: Giao diện -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/label_theme"
                android:textAppearance="@style/TextAppearance.App.Body"
                android:textColor="@color/color_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/desc_theme"
                android:textAppearance="@style/TextAppearance.App.Caption"
                android:textColor="@color/color_text_secondary"
                android:textSize="13sp" />

            <!-- 3 thẻ chọn Giao diện (Sáng / Tối / Hệ thống) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <!-- Thẻ Sáng -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_theme_light"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1.5dp"
                    app:strokeColor="@color/color_accent"
                    app:cardBackgroundColor="@color/color_surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center">

                        <ImageView
                            android:id="@+id/iv_theme_light"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_light_mode"
                            android:contentDescription="@null"
                            app:tint="@color/color_accent" />

                        <TextView
                            android:id="@+id/tv_theme_light"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/theme_light"
                            android:textColor="@color/color_accent"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Thẻ Tối -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_theme_dark"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="3dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/border"
                    app:cardBackgroundColor="@color/color_surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center">

                        <ImageView
                            android:id="@+id/iv_theme_dark"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_dark_mode"
                            android:contentDescription="@null"
                            app:tint="@color/color_text_secondary" />

                        <TextView
                            android:id="@+id/tv_theme_dark"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/theme_dark"
                            android:textColor="@color/color_text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Thẻ Hệ thống -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_theme_system"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/border"
                    app:cardBackgroundColor="@color/color_surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center">

                        <ImageView
                            android:id="@+id/iv_theme_system"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_devices"
                            android:contentDescription="@null"
                            app:tint="@color/color_text_secondary" />

                        <TextView
                            android:id="@+id/tv_theme_system"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/theme_system"
                            android:textColor="@color/color_text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- 2. Mục: Sắp xếp mặc định -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/label_default_sort"
                android:textAppearance="@style/TextAppearance.App.Body"
                android:textColor="@color/color_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/desc_default_sort"
                android:textAppearance="@style/TextAppearance.App.Caption"
                android:textColor="@color/color_text_secondary"
                android:textSize="13sp" />

            <!-- Khung Card chứa 3 RadioButton sắp xếp -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border"
                app:cardBackgroundColor="@color/color_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Hàng: Tên A–Z -->
                    <LinearLayout
                        android:id="@+id/row_sort_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp"
                        android:clickable="true"
                        android:focusable="true">

                        <RadioButton
                            android:id="@+id/rb_sort_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/color_accent"
                            android:clickable="false"
                            android:focusable="false" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/sort_option_name"
                                android:textAppearance="@style/TextAppearance.App.Body"
                                android:textColor="@color/color_text_primary"
                                android:textStyle="bold"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="@string/sort_option_name_desc"
                                android:textAppearance="@style/TextAppearance.App.Caption"
                                android:textColor="@color/color_text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="14dp"
                        android:background="@color/border" />

                    <!-- Hàng: Đánh giá -->
                    <LinearLayout
                        android:id="@+id/row_sort_rating"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp"
                        android:clickable="true"
                        android:focusable="true">

                        <RadioButton
                            android:id="@+id/rb_sort_rating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/color_accent"
                            android:clickable="false"
                            android:focusable="false" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/sort_option_rating"
                                android:textAppearance="@style/TextAppearance.App.Body"
                                android:textColor="@color/color_text_primary"
                                android:textStyle="bold"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="@string/sort_option_rating_desc"
                                android:textAppearance="@style/TextAppearance.App.Caption"
                                android:textColor="@color/color_text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="14dp"
                        android:background="@color/border" />

                    <!-- Hàng: Ngày thêm -->
                    <LinearLayout
                        android:id="@+id/row_sort_date"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp"
                        android:clickable="true"
                        android:focusable="true">

                        <RadioButton
                            android:id="@+id/rb_sort_date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/color_accent"
                            android:clickable="false"
                            android:focusable="false" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/sort_option_date"
                                android:textAppearance="@style/TextAppearance.App.Body"
                                android:textColor="@color/color_text_primary"
                                android:textStyle="bold"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="@string/sort_option_date_desc"
                                android:textAppearance="@style/TextAppearance.App.Caption"
                                android:textColor="@color/color_text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. Mục: Ngôn ngữ (Bước 12) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/label_language"
                android:textAppearance="@style/TextAppearance.App.Body"
                android:textColor="@color/color_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/desc_language"
                android:textAppearance="@style/TextAppearance.App.Caption"
                android:textColor="@color/color_text_secondary"
                android:textSize="13sp" />

            <!-- Khung Card chứa 2 RadioButton ngôn ngữ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border"
                app:cardBackgroundColor="@color/color_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Hàng: Tiếng Việt -->
                    <LinearLayout
                        android:id="@+id/row_lang_vi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp"
                        android:clickable="true"
                        android:focusable="true">

                        <RadioButton
                            android:id="@+id/rb_lang_vi"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/color_accent"
                            android:clickable="false"
                            android:focusable="false" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/lang_vietnamese"
                                android:textAppearance="@style/TextAppearance.App.Body"
                                android:textColor="@color/color_text_primary"
                                android:textStyle="bold"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="@string/lang_vietnamese_desc"
                                android:textAppearance="@style/TextAppearance.App.Caption"
                                android:textColor="@color/color_text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="14dp"
                        android:background="@color/border" />

                    <!-- Hàng: English -->
                    <LinearLayout
                        android:id="@+id/row_lang_en"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp"
                        android:clickable="true"
                        android:focusable="true">

                        <RadioButton
                            android:id="@+id/rb_lang_en"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/color_accent"
                            android:clickable="false"
                            android:focusable="false" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/lang_english"
                                android:textAppearance="@style/TextAppearance.App.Body"
                                android:textColor="@color/color_text_primary"
                                android:textStyle="bold"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="@string/lang_english_desc"
                                android:textAppearance="@style/TextAppearance.App.Caption"
                                android:textColor="@color/color_text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Chân trang: SỞ THÍCH • SỔ TAY GIÁM TUYỂN CÁ NHÂN -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="24dp"
                android:gravity="center"
                android:text="@string/settings_footer_credit"
                android:textAppearance="@style/TextAppearance.App.Caption"
                android:textColor="@color/color_text_secondary"
                android:textSize="10.5sp"
                android:letterSpacing="0.08" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Thanh điều hướng đáy dùng chung (layout_bottom_nav) -->
    <include
        android:id="@+id/included_bottom_nav"
        layout="@layout/layout_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
