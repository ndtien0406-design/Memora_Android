<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Quyền truy cập máy ảnh để chụp ảnh sở thích -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Quyền ghi âm giọng nói cho ghi chú -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Quyền hiển thị thông báo (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Quyền đặt báo thức chính xác (Android 12+) cho lời nhắc sở thích -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Quyền nhận sự kiện khởi động lại thiết bị để khôi phục lịch nhắc -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".SoThichApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.SoThich">

        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" />

        <!-- SplashActivity sử dụng SplashScreen API, là LAUNCHER của ứng dụng -->
        <activity
            android:name=".ui.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.App.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.SoThich" />

        <activity
            android:name=".ui.AddEditHobbyActivity"
            android:exported="false"
            android:theme="@style/Theme.SoThich"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.HobbyDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.SoThich" />

        <activity
            android:name=".ui.StatsActivity"
            android:exported="false"
            android:theme="@style/Theme.SoThich" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.SoThich" />

        <!-- BroadcastReceiver hiển thị thông báo nhắc nhở khi đến giờ (Bước 11) -->
        <receiver
            android:name=".receiver.ReminderReceiver"
            android:exported="false" />

        <!-- BroadcastReceiver khôi phục lịch nhắc nhở sau khi thiết bị khởi động lại (Bước 11) -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- FileProvider để chia sẻ tệp ảnh an toàn cho Camera -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
